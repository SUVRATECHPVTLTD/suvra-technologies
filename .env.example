# GEMINI_API_KEY: Required for Gemini AI API calls if server-side AI features are enabled later.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The runtime preview URL where this applet is hosted.
# AI Studio automatically injects this at runtime and Vite uses it for preview metadata only.
APP_URL="MY_APP_URL"

# SITE_URL / VITE_SITE_URL: Purchased production domain origin (e.g. https://your-purchased-domain).
# Leave empty during development, preview, and staging to preserve noindex protection.
SITE_URL=""
VITE_SITE_URL=""

# ALLOW_INDEXING / VITE_ALLOW_INDEXING: Set to "true" ONLY when deploying to the verified production domain.
ALLOW_INDEXING="false"
VITE_ALLOW_INDEXING="false"

# GOOGLE_SITE_VERIFICATION / VITE_GSC_VERIFICATION: Google Search Console meta verification token (optional until launch).
GOOGLE_SITE_VERIFICATION=""
VITE_GSC_VERIFICATION=""

# VITE_API_BASE_URL: Base origin for the future Cloudflare Workers + Hono backend API.
VITE_API_BASE_URL=""
